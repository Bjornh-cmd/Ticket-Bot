                <p class="muted"><%- d('access.noneInvited') %></p>
              <% } else { %>
                <table>
                  <thead><tr><th><%= d('access.thName') %></th><th><%= d('access.thUserId') %></th><th><%= d('access.thAdded') %></th><th></th></tr></thead>
                  <tbody>
                    <% panelStaff.forEach(function(s) {

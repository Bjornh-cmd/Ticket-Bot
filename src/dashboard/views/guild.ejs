            <section class="panel">
              <h2><%= d('access.linkLoginTitle') %></h2>
              <p class="muted"><%- d('access.linkLoginLead') %></p>
              <% if (!features.linkLogin) { %>
                <p class="err-banner" style="margin:0"><%- d('access.linkLoginLocked') %></p>
              <% } else if (!isGuildOwner) { %>
                <p class="err-banner"><%= d('access.linkLoginOwnerOnly') %></p>
              <% } else { %>
                <form method="post" action="/guild/<%= guildMeta.id %>/link-login" class="form-grid">
                  <label class="full" style="display:flex;align-items:center;gap:0.55rem">
                    <input type="checkbox" name="enabled" value="1" <%= guildLinkLogin && guildLinkLogin.enabled ? 'checked' : '' %> />
                    <%= d('access.linkLoginEnable') %>
                  </label>
                  <label><%= d('access.linkLoginSlug') %>
                    <input name="path_slug" value="<%= guildLinkLogin ? guildLinkLogin.pathSlug : '' %>" pattern="[A-Za-z0-9_-]+" required maxlength="64" />
                  </label>
                  <label><%= d('access.linkLoginPassword') %>
                    <input type="password" name="password" placeholder="<%= guildLinkLogin && guildLinkLogin.hasPassword ? d('access.linkLoginPasswordKeep') : d('access.linkLoginPasswordNew') %>" <%= guildLinkLogin && guildLinkLogin.hasPassword ? '' : 'required' %> autocomplete="new-password" />
                  </label>
                  <button class="btn" type="submit"><%= d('access.linkLoginSave') %></button>

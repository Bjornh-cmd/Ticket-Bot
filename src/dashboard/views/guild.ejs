                      var label = s.username || (mem && mem.displayName) || '—';
                    %>
                      <tr>
                        <td><%= label %></td>
                        <td><code><%= s.user_id %></code></td>
                        <td><%= s.created_at %></td>
                        <td>
                          <% if (isGuildOwner) { %>
                            <form method="post" action="/guild/<%= guildMeta.id %>/staff/<%= s.user_id %>/remove">
                              <button class="btn ghost small" type="submit"><%= d('common.remove') %></button>
                            </form>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              <% } %>

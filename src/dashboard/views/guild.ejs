<!DOCTYPE html>
<html lang="<%= guildLocale === 'nl' ? 'nl' : 'en' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= guildMeta.name %> · Reedhall</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="shell">
    <aside class="shell-side">
      <a class="brand" href="/dashboard"><img class="brand-logo" src="/logo.png" alt="" />Reedhall</a>
      <nav class="side-nav">
        <a href="/dashboard"><%= d('nav.overview') %></a>
        <% if (features.analytics) { %><a href="/status/<%= guildMeta.id %>">Status</a><% } %>
        <a href="/help"><%= d('nav.help') %></a>
        <button type="button" class="active" data-tab="overview"><%= d('nav.server') %></button>
        <% if (isGuildOwner && features.serverSetup) { %><button type="button" data-tab="setup"><%= d('nav.setup') %></button><% } %>
        <button type="button" data-tab="settings"><%= d('nav.settings') %></button>
        <button type="button" data-tab="access"><%= d('nav.access') %></button>
        <button type="button" data-tab="tickets"><%= d('nav.tickets') %></button>
        <button type="button" data-tab="messages"><%= d('nav.messages') %></button>
        <button type="button" data-tab="polls"><%= d('nav.polls') %></button>
        <button type="button" data-tab="giveaways"><%= d('nav.giveaways') %></button>
        <% if (isGuildOwner && features.commandOverrides) { %><button type="button" data-tab="commands"><%= d('nav.commands') %></button><% } %>
        <button type="button" data-tab="branding"><%= d('nav.branding') %></button>
        <button type="button" data-tab="logs"><%= d('nav.logs') %></button>
      </nav>
      <div class="side-foot">
        <div><%= guildMeta.name %></div>
        <div style="margin-top:0.35rem" class="muted"><%= plan.name %> · <%= user.global_name || user.username %></div>
      </div>
    </aside>

    <div class="shell-main">
      <header class="shell-top">
        <div>
          <a class="back" href="/dashboard"><%= d('nav.backToServers') %></a>
          <strong style="font-family:var(--display);display:block;margin-top:0.15rem"><%= guildMeta.name %></strong>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:center">
          <a class="btn ghost small" href="/logout"><%= d('nav.logout') %></a>
        </div>
      </header>

      <nav class="mobile-nav" aria-label="<%= d('nav.sectionsAriaLabel') %>">
        <button type="button" data-tab="overview"><%= d('nav.server') %></button>
        <% if (isGuildOwner) { %><button type="button" data-tab="setup"><%= d('nav.setupShort') %></button><% } %>
        <button type="button" data-tab="settings"><%= d('nav.settings') %></button>
        <button type="button" data-tab="access"><%= d('nav.access') %></button>
        <button type="button" data-tab="tickets"><%= d('nav.tickets') %></button>
        <button type="button" data-tab="messages"><%= d('nav.messages') %></button>
        <button type="button" data-tab="polls"><%= d('nav.polls') %></button>
        <button type="button" data-tab="giveaways"><%= d('nav.giveaways') %></button>
        <% if (isGuildOwner && features.commandOverrides) { %><button type="button" data-tab="commands"><%= d('nav.commands') %></button><% } %>
        <button type="button" data-tab="branding"><%= d('nav.branding') %></button>
        <button type="button" data-tab="logs"><%= d('nav.logsShort') %></button>
      </nav>

      <main class="shell-content">
        <% if (saved) { %><p class="ok-banner"><%= d('flash.saved') %></p><% } %>
        <% if (flash === 'panel_sent') { %><p class="ok-banner"><%= d('flash.panel_sent') %></p><% } %>
        <% if (flash === 'type_added') { %><p class="ok-banner"><%= d('flash.type_added') %></p><% } %>
        <% if (flash === 'type_saved') { %><p class="ok-banner"><%= d('flash.type_saved') %></p><% } %>
        <% if (flash === 'type_deleted') { %><p class="ok-banner"><%= d('flash.type_deleted') %></p><% } %>
        <% if (flash === 'type_missing') { %><p class="err-banner"><%= d('flash.type_missing') %></p><% } %>
        <% if (flash === 'ticket_closed') { %><p class="ok-banner"><%= d('flash.ticket_closed') %></p><% } %>
        <% if (flash === 'ticket_missing') { %><p class="err-banner"><%= d('flash.ticket_missing') %></p><% } %>
        <% if (flash === 'poll_missing') { %><p class="err-banner"><%= d('flash.poll_missing') %></p><% } %>
        <% if (flash === 'warn_deleted') { %><p class="ok-banner"><%= d('flash.warn_deleted') %></p><% } %>
        <% if (flash === 'need_category') { %><p class="err-banner"><%= d('flash.need_category') %></p><% } %>
        <% if (flash === 'bad_channel') { %><p class="err-banner"><%= d('flash.bad_channel') %></p><% } %>
        <% if (flash === 'say_sent') { %><p class="ok-banner"><%= d('flash.say_sent') %></p><% } %>
        <% if (flash === 'say_empty') { %><p class="err-banner"><%= d('flash.say_empty') %></p><% } %>
        <% if (flash === 'say_failed') { %><p class="err-banner"><%= d('flash.say_failed') %></p><% } %>
        <% if (flash === 'poll_sent') { %><p class="ok-banner"><%= d('flash.poll_sent') %></p><% } %>
        <% if (flash === 'poll_ended') { %><p class="ok-banner"><%= d('flash.poll_ended') %></p><% } %>
        <% if (flash === 'poll_invalid') { %><p class="err-banner"><%= d('flash.poll_invalid') %></p><% } %>
        <% if (flash === 'poll_date') { %><p class="err-banner"><%= d('flash.poll_date') %></p><% } %>
        <% if (flash === 'poll_failed') { %><p class="err-banner"><%= d('flash.poll_failed') %></p><% } %>
        <% if (flash === 'plan_locked') { %><p class="err-banner"><%- d('flash.plan_locked', { plan: plan.name }) %></p><% } %>
        <% if (flash === 'branding_locked') { %><p class="err-banner"><%- d('flash.branding_locked') %></p><% } %>
        <% if (flash === 'branding_saved') { %><p class="ok-banner"><%= d('flash.branding_saved') %></p><% } %>
        <% if (flash === 'branding_failed') { %><p class="err-banner"><%= d('flash.branding_failed') %></p><% } %>
        <% if (flash === 'branding_png') { %><p class="err-banner"><%- d('flash.branding_png') %></p><% } %>
        <% if (flash === 'branding_size') { %><p class="err-banner"><%= d('flash.branding_size') %></p><% } %>
        <% if (flash === 'giveaway_sent') { %><p class="ok-banner"><%= d('flash.giveaway_sent') %></p><% } %>
        <% if (flash === 'giveaway_ended') { %><p class="ok-banner"><%= d('flash.giveaway_ended') %></p><% } %>
        <% if (flash === 'giveaway_reroll') { %><p class="ok-banner"><%= d('flash.giveaway_reroll') %></p><% } %>
        <% if (flash === 'giveaway_invalid') { %><p class="err-banner"><%= d('flash.giveaway_invalid') %></p><% } %>
        <% if (flash === 'giveaway_image') { %><p class="err-banner"><%= d('flash.giveaway_image') %></p><% } %>
        <% if (flash === 'giveaway_failed') { %><p class="err-banner"><%= d('flash.giveaway_failed') %></p><% } %>
        <% if (flash === 'giveaway_perms') { %><p class="err-banner"><%- d('flash.giveaway_perms') %></p><% } %>
        <% if (flash === 'discord_perms') { %><p class="err-banner"><%- d('flash.discord_perms') %></p><% } %>
        <% if (flash === 'discord_access') { %><p class="err-banner"><%- d('flash.discord_access') %></p><% } %>
        <% if (flash === 'discord_unknown_channel') { %><p class="err-banner"><%- d('flash.discord_unknown_channel') %></p><% } %>
        <% if (flash === 'discord_category_full') { %><p class="err-banner"><%- d('flash.discord_category_full') %></p><% } %>
        <% if (flash === 'discord_cannot_dm') { %><p class="err-banner"><%- d('flash.discord_cannot_dm') %></p><% } %>
        <% if (flash === 'discord_invalid') { %><p class="err-banner"><%- d('flash.discord_invalid') %></p><% } %>
        <% if (flash === 'giveaway_active') { %><p class="err-banner"><%= d('flash.giveaway_active') %></p><% } %>
        <% if (flash === 'giveaway_empty') { %><p class="err-banner"><%= d('flash.giveaway_empty') %></p><% } %>
        <% if (flash === 'purge_done') { %><p class="ok-banner"><%= d('flash.purge_done') %></p><% } %>
        <% if (flash === 'purge_one') { %><p class="ok-banner"><%= d('flash.purge_one') %></p><% } %>
        <% if (flash === 'purge_failed') { %><p class="err-banner"><%= d('flash.purge_failed') %></p><% } %>
        <% if (flash === 'setup_created') { %><p class="ok-banner"><%= d('flash.setup_created') %></p><% } %>
        <% if (flash === 'setup_saved') { %><p class="ok-banner"><%= d('flash.setup_saved') %></p><% } %>
        <% if (flash === 'setup_blueprint') { %><p class="ok-banner"><%= d('flash.setup_blueprint') %></p><% } %>
        <% if (flash === 'setup_owner_only') { %><p class="err-banner"><%= d('flash.setup_owner_only') %></p><% } %>
        <% if (flash === 'setup_failed') { %><p class="err-banner"><%= d('flash.setup_failed') %></p><% } %>
        <% if (flash === 'setup_bad_channel') { %><p class="err-banner"><%= d('flash.setup_bad_channel') %></p><% } %>
        <% if (flash === 'staff_added') { %><p class="ok-banner"><%- d('flash.staff_added') %></p><% } %>
        <% if (flash === 'staff_removed') { %><p class="ok-banner"><%= d('flash.staff_removed') %></p><% } %>
        <% if (flash === 'staff_owner_only') { %><p class="err-banner"><%= d('flash.staff_owner_only') %></p><% } %>
        <% if (flash === 'staff_lobby') { %><p class="err-banner"><%= d('flash.staff_lobby') %></p><% } %>
        <% if (flash === 'staff_limit') { %><p class="err-banner"><%= d('flash.staff_limit', { max: maxStaff, plan: plan.name }) %></p><% } %>
        <% if (flash === 'staff_invalid') { %><p class="err-banner"><%= d('flash.staff_invalid') %></p><% } %>
        <% if (flash === 'staff_self') { %><p class="err-banner"><%= d('flash.staff_self') %></p><% } %>
        <% if (flash === 'staff_none') { %><p class="err-banner"><%= d('flash.staff_none') %></p><% } %>
        <% if (flash === 'staff_exists') { %><p class="err-banner"><%= d('flash.staff_exists') %></p><% } %>
        <% if (flash === 'link_saved') { %><p class="ok-banner"><%= d('flash.link_saved') %></p><% } %>
        <% if (flash === 'link_owner_only') { %><p class="err-banner"><%= d('flash.link_owner_only') %></p><% } %>
        <% if (flash === 'link_slug_taken') { %><p class="err-banner"><%= d('flash.link_slug_taken') %></p><% } %>
        <% if (flash === 'link_password_required') { %><p class="err-banner"><%= d('flash.link_password_required') %></p><% } %>
        <% if (flash === 'link_failed') { %><p class="err-banner"><%= d('flash.link_failed') %></p><% } %>
        <% if (flash === 'cmd_saved') { %><p class="ok-banner"><%= d('flash.cmd_saved') %></p><% } %>
        <% if (flash === 'cmd_invalid') { %><p class="err-banner"><%= d('flash.cmd_invalid') %></p><% } %>
        <% if (flash === 'prefix_added') { %><p class="ok-banner"><%= d('flash.prefix_added') %></p><% } %>
        <% if (flash === 'prefix_saved') { %><p class="ok-banner"><%= d('flash.prefix_saved') %></p><% } %>
        <% if (flash === 'prefix_deleted') { %><p class="ok-banner"><%= d('flash.prefix_deleted') %></p><% } %>
        <% if (flash === 'prefix_missing') { %><p class="err-banner"><%= d('flash.prefix_missing') %></p><% } %>
        <% if (flash === 'prefix_empty') { %><p class="err-banner"><%= d('flash.prefix_empty') %></p><% } %>
        <% if (flash === 'prefix_exists') { %><p class="err-banner"><%= d('flash.prefix_exists') %></p><% } %>
        <% if (flash === 'prefix_invalid') { %><p class="err-banner"><%= d('flash.prefix_invalid') %></p><% } %>
        <% if (flash === 'prefix_limit') { %><p class="err-banner"><%= d('flash.prefix_limit', { max: maxPrefixCommands === Infinity ? '∞' : maxPrefixCommands, plan: plan.name }) %></p><% } %>

        <div class="tab-panels">
          <div data-panel="overview" class="is-open">
            <div class="page-head">
              <h1><%= d('overview.title') %></h1>
              <p><%= d('overview.lead', { server: guildMeta.name }) %></p>
            </div>
            <section class="metric-row">
              <div class="metric"><strong><%= overview.members %></strong><span><%= d('overview.members') %></span></div>
              <div class="metric"><strong><%= overview.channels %></strong><span><%= d('overview.channels') %></span></div>
              <div class="metric"><strong><%= overview.openTickets %></strong><span><%= d('overview.openTickets') %></span></div>
              <div class="metric"><strong><%= overview.activePolls %></strong><span><%= d('overview.activePolls') %></span></div>
            </section>
            <section class="panel">
              <h2><%= d('overview.quickStart') %></h2>
              <p class="muted"><%= d('overview.botLabel') %> <strong><%= overview.botNick %></strong> · <%= d('overview.planLabel') %> <strong><%= plan.name %></strong> · <%= d('overview.warnsLabel') %> <strong><%= overview.activeWarns %></strong></p>
              <div class="cta-row">
                <button type="button" class="btn" data-tab="settings"><%= d('nav.settings') %></button>
                <% if (isGuildOwner) { %><button type="button" class="btn ghost" data-tab="setup"><%= d('nav.setup') %></button><% } %>
                <% if (features.polls) { %><button type="button" class="btn ghost" data-tab="polls"><%= d('overview.newPoll') %></button><% } %>
                <% if (features.botSay) { %><button type="button" class="btn ghost" data-tab="messages"><%= d('overview.sendMessage') %></button><% } %>
                <% if (features.branding) { %><button type="button" class="btn ghost" data-tab="branding"><%= d('nav.branding') %></button><% } else { %>
                  <a class="btn ghost" href="/account"><%= d('common.upgradeForBranding') %></a>
                <% } %>
              </div>
            </section>
            <% if (features.analytics && health) { %>
            <section class="panel">
              <h2><%= d('overview.analyticsTitle') %></h2>
              <div class="metric-row">
                <div class="metric"><strong><%= health.closedTickets %></strong><span><%= d('overview.closedTickets') %></span></div>
                <div class="metric"><strong><%= health.modActions24h %></strong><span><%= d('overview.modActions24h') %></span></div>
                <div class="metric"><strong><%= health.activeGiveaways %></strong><span><%= d('overview.activeGiveaways') %></span></div>
              </div>
              <p class="muted" style="margin:0.75rem 0 0"><a href="/status/<%= guildMeta.id %>"><%= d('overview.openStatus') %></a></p>
            </section>
            <% } %>
            <section class="panel">
              <h2><%= d('overview.checklistTitle') %></h2>
              <ul class="checklist">
                <li class="<%= overview.checklist.modRole ? 'done' : '' %>"><%= d('overview.checklistModRole') %></li>
                <li class="<%= overview.checklist.supportRole ? 'done' : '' %>"><%= d('overview.checklistSupportRole') %></li>
                <li class="<%= overview.checklist.ticketCategory ? 'done' : '' %>"><%= d('overview.checklistTicketCategory') %></li>
                <li class="<%= overview.checklist.ticketTypes ? 'done' : '' %>"><%= d('overview.checklistTicketTypes') %></li>
                <li class="<%= overview.checklist.ticketPanel ? 'done' : '' %>"><%= d('overview.checklistTicketPanel') %></li>
                <li class="<%= overview.checklist.welcome ? 'done' : '' %>"><%= d('overview.checklistWelcome') %></li>
                <li class="<%= overview.checklist.suggestions ? 'done' : '' %>"><%= d('overview.checklistSuggestions') %></li>
              </ul>
            </section>
          </div>

          <% if (isGuildOwner && features.serverSetup) { %>
          <div data-panel="setup">
            <div class="page-head">
              <h1><%= d('nav.setup') %></h1>
              <p><%- d('setup.lead') %></p>
            </div>

            <section class="panel">
              <h2><%= d('setup.step1Title') %></h2>
              <p class="muted"><%= d('setup.step1Lead') %></p>
              <form method="post" action="/guild/<%= guildMeta.id %>/setup/create" id="blueprint-form" class="blueprint-form">
                <div id="blueprint-cats" data-map-options='<%= JSON.stringify(botMapOptions || []) %>'>
                  <% if (!(layoutBlueprint.categories || []).length) { %>
                    <p class="muted" style="margin:0 0 0.75rem"><%= d('setup.emptyCategories') %></p>
                  <% } %>
                  <% (layoutBlueprint.categories || []).forEach(function(cat) { %>
                    <div class="setup-block bp-cat" data-cat-id="<%= cat.id %>">
                      <div class="bp-cat-head">
                        <input type="hidden" name="bp_cat_id" value="<%= cat.id %>" />
                        <label class="full"><%= d('setup.categoryLabel') %>
                          <input name="bp_cat_name" value="<%= cat.name %>" required maxlength="100" />
                        </label>
                        <button type="button" class="btn ghost small bp-remove-cat"><%= d('setup.removeCategory') %></button>
                      </div>
                      <div class="bp-channels">
                        <% (cat.channels || []).forEach(function(ch) { %>
                          <div class="bp-channel-row">
                            <input type="hidden" name="bp_ch_id_<%= cat.id %>" value="<%= ch.id %>" />
                            <input name="bp_ch_name_<%= cat.id %>" value="<%= ch.name %>" placeholder="<%= d('setup.channelNamePlaceholder') %>" maxlength="100" required />
                            <select name="bp_ch_map_<%= cat.id %>">
                              <% (botMapOptions || []).forEach(function(opt) { %>
                                <option value="<%= opt.value %>" <%= (ch.mapsTo || '') === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                              <% }) %>
                            </select>
                            <button type="button" class="btn ghost small bp-remove-ch" aria-label="<%= d('setup.removeAria') %>">−</button>
                          </div>
                        <% }) %>
                      </div>
                      <button type="button" class="btn ghost small bp-add-ch"><%= d('setup.addChannel') %></button>
                    </div>
                  <% }) %>
                </div>
                <div class="setup-block">
                  <label class="full"><%= d('setup.hiddenTicketCategory') %>
                    <input name="bp_ticket_cat_name" value="<%= layoutBlueprint.ticketCategory && layoutBlueprint.ticketCategory.name || '🎫 TICKETS' %>" maxlength="100" />
                  </label>
                </div>
                <div class="cta-row" style="margin-top:0.5rem">
                  <button type="button" class="btn ghost" id="bp-add-cat"><%= d('setup.addCategory') %></button>
                  <button type="submit" formaction="/guild/<%= guildMeta.id %>/setup/blueprint" class="btn ghost"><%= d('setup.saveBlueprint') %></button>
                  <button type="submit" class="btn" onclick="return confirm('<%= d('js.confirmCreateStructure') %>');"><%= d('setup.createStructure') %></button>
                </div>
              </form>
            </section>

            <section class="panel">
              <h2><%= d('setup.step2Title') %></h2>
              <p class="muted"><%= d('setup.step2Lead') %></p>
              <form method="post" action="/guild/<%= guildMeta.id %>/setup/save" class="setup-form">
                <% (layoutBlueprint.categories || []).forEach(function(cat) { %>
                  <div class="setup-block">
                    <h3><%= cat.name %></h3>
                    <label class="full"><%= d('setup.categoryOptional') %>
                      <select name="cat_<%= cat.id %>">
                        <option value=""><%= d('common.notLinked') %></option>
                        <% categories.forEach(function(c) { %>
                          <option value="<%= c.id %>" <%= layout.categories && layout.categories[cat.id] === c.id ? 'selected' : '' %>><%= c.name %></option>
                        <% }) %>
                      </select>
                    </label>
                    <div class="form-grid">
                      <% (cat.channels || []).forEach(function(ch) { %>
                        <label># <%= ch.name %>
                          <select name="ch_<%= ch.id %>">
                            <option value=""><%= d('common.notSet') %></option>
                            <% textChannels.forEach(function(c) { %>
                              <option value="<%= c.id %>" <%= layout.channels && layout.channels[ch.id] === c.id ? 'selected' : '' %>><%= c.name %></option>
                            <% }) %>
                          </select>
                        </label>
                      <% }) %>
                    </div>
                  </div>
                <% }) %>
                <div class="setup-block">
                  <h3><%= layoutBlueprint.ticketCategory && layoutBlueprint.ticketCategory.name || '🎫 TICKETS' %></h3>
                  <label class="full"><%= d('setup.ticketCategoryLive') %>
                    <select name="cat_tickets_live">
                      <option value=""><%= d('common.notSet') %></option>
                      <% categories.forEach(function(c) { %>
                        <option value="<%= c.id %>" <%= layout.categories && layout.categories.tickets_live === c.id ? 'selected' : '' %>><%= c.name %></option>
                      <% }) %>
                    </select>
                  </label>
                </div>
                <button class="btn" type="submit"><%= d('setup.saveLinks') %></button>
              </form>
            </section>

            <section class="panel">
              <h2><%= d('setup.step3Title') %></h2>
              <p class="muted"><%= d('setup.step3Lead') %></p>
              <ol class="help-guide">
                <li>
                  <h3><%= d('setup.guideTicketsTitle') %></h3>
                  <p><%= d('setup.guideTicketsBody') %></p>
                  <button type="button" class="btn small" data-tab="tickets" style="margin-top:0.55rem"><%= d('nav.tickets') %></button>
                </li>
                <li>
                  <h3><%= d('setup.guideStaffTitle') %></h3>
                  <p><%= d('setup.guideStaffBody') %></p>
                  <div class="cta-row" style="margin-top:0.55rem">
                    <button type="button" class="btn small" data-tab="settings"><%= d('nav.settings') %></button>
                    <button type="button" class="btn ghost small" data-tab="access"><%= d('nav.access') %></button>
                  </div>
                </li>
                <li>
                  <h3><%= d('setup.guidePanelTitle') %></h3>
                  <p><%= d('setup.guidePanelBody') %></p>
                </li>
              </ol>
              <ul class="checklist" style="margin-top:1rem">
                <li class="<%= overview.checklist.ticketCategory ? 'done' : '' %>"><%= d('overview.checklistTicketCategory') %></li>
                <li class="<%= overview.checklist.ticketTypes ? 'done' : '' %>"><%= d('overview.checklistTicketTypes') %></li>
                <li class="<%= overview.checklist.supportRole ? 'done' : '' %>"><%= d('overview.checklistSupportRole') %></li>
                <li class="<%= overview.checklist.modRole ? 'done' : '' %>"><%= d('overview.checklistModRole') %></li>
                <li class="<%= overview.checklist.panelStaff ? 'done' : '' %>"><%= d('overview.checklistPanelStaff') %></li>
                <li class="<%= overview.checklist.ticketPanel ? 'done' : '' %>"><%= d('overview.checklistTicketPanel') %></li>
              </ul>
              <p class="muted" style="margin:0.85rem 0 0"><a href="/help#setup"><%= d('setup.readHelp') %></a></p>
            </section>
          </div>
          <% } %>

          <div data-panel="settings">
            <div class="page-head">
              <h1><%= d('nav.settings') %></h1>
              <p><%- d('settings.lead') %></p>
            </div>

            <section class="panel">
              <h2><%= d('settings.rolesTitle') %></h2>
              <p class="muted"><%= d('settings.rolesLead') %></p>
              <form method="post" action="/guild/<%= guildMeta.id %>/settings" class="form-grid">
                <input type="hidden" name="return_tab" value="settings" />
                <label><%= d('settings.localeLabel') %>
                  <select name="locale">
                    <% (locales || []).forEach(function(l) { %>
                      <option value="<%= l.id %>" <%= guildLocale === l.id ? 'selected' : '' %>><%= l.native %> (<%= l.label %>)</option>
                    <% }) %>
                  </select>
                </label>

                <% ticketTypes.forEach(function(t) { %>
                  <details class="ticket-type-card" <%= String(flash) === 'type_saved' ? '' : '' %>>
                    <summary>
                      <span><%= t.emoji || '🎫' %> <strong><%= t.name %></strong></span>
                      <span class="muted">
                        <%= (t.questions && t.questions.length) ? d('tickets.questionsCount', { n: t.questions.length }) : d('tickets.questionsDefault') %>
                      </span>

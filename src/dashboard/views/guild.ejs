                    <form method="post" action="/guild/<%= guildMeta.id %>/ticket-types/<%= t.id %>" class="form-grid" style="margin-top:0.85rem">
                      <label><%= d('tickets.nameLabel') %><input name="name" value="<%= t.name %>" required /></label>
                      <label><%= d('tickets.emojiLabel') %><input name="emoji" value="<%= t.emoji || '🎫' %>" maxlength="8" /></label>

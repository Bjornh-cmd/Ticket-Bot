                <label><%= d('tickets.emojiLabel') %><input name="emoji" placeholder="🎫" maxlength="8" /></label>
                <label class="full"><%= d('tickets.descriptionLabel') %><input name="description" placeholder="<%= d('tickets.descriptionPlaceholder') %>" /></label>
                <div class="full">
                  <h3 style="margin:0.35rem 0 0.55rem;font-size:0.95rem"><%= d('tickets.questionsTitle') %></h3>
                  <p class="muted" style="margin:0 0 0.65rem"><%= d('tickets.questionsHint') %></p>
                  <% if (features.ticketQuestionnaires) { %>
                    <div class="ticket-questions-wrap" data-max="5">
                      <div class="ticket-questions-list"></div>
                      <button type="button" class="btn ghost small ticket-q-add" style="margin-top:0.55rem"><%= d('tickets.addQuestion') %></button>
                    </div>
                  <% } else { %>
                    <p class="err-banner" style="margin:0"><%- d('tickets.questionsLocked') %></p>
                  <% } %>
                </div>
                <button class="btn" type="submit"><%= d('tickets.addButton') %></button>
              </form>
            </section>

            <section class="panel">

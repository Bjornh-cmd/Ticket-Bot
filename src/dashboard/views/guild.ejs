            <section class="panel">
              <p class="muted">
                <%= d('access.planPrefix') %> <strong><%= plan.name %></strong>:
                <% if (maxStaff === 0) { %><%= d('access.noExtraMods') %><% } else if (!Number.isFinite(maxStaff)) { %><%= d('access.unlimitedMods') %><% } else { %><%= d('access.maxMods', { max: maxStaff, current: panelStaff.length }) %><% } %>
              </p>
              <% if (!isGuildOwner) { %>
                <p class="err-banner"><%= d('access.notOwner') %></p>
              <% } else if (maxStaff === 0) { %>
                <p class="err-banner"><%- d('access.lobbyLocked') %></p>
              <% } else { %>
                <form method="post" action="/guild/<%= guildMeta.id %>/staff" class="form-grid" id="staff-invite-form">
                  <label><%= d('access.inviteViaLabel') %>
                    <select name="invite_mode" id="staff-invite-mode">
                      <option value="member"><%= d('access.optionMember') %></option>
                      <option value="role"><%= d('access.optionRole') %></option>
                    </select>
                  </label>
                  <label id="staff-member-wrap"><%= d('access.memberLabel') %>
                    <select name="user_id" id="staff-user-select">
                      <option value=""><%= d('common.chooseMember') %></option>
                      <%
                        var ownerId = discordGuild ? String(discordGuild.ownerId) : '';
                        (members || []).forEach(function(m) {
                          if (String(m.id) === ownerId) return;
                      %>
                        <option value="<%= m.id %>" data-username="<%= m.displayName %>"><%= m.displayName %> (@<%= m.username %>)</option>
                      <% }) %>
                    </select>
                  </label>
                  <label id="staff-role-wrap" hidden><%= d('access.roleLabel') %>
                    <select name="role_id" id="staff-role-select">
                      <option value=""><%= d('common.chooseRole') %></option>
                      <% (roles || []).forEach(function(r) { %>
                        <option value="<%= r.id %>">@<%= r.name %></option>
                      <% }) %>
                    </select>
                  </label>
                  <input type="hidden" name="username" id="staff-username" value="" />
                  <p class="muted full" id="staff-invite-hint"><%= d('js.inviteHintMember', { server: guildMeta.name }) %></p>
                  <% if (!(members || []).length) { %>
                    <p class="err-banner full" style="margin:0">
                      <%= d('access.noMembersLoaded') %>
                      <a href="/guild/<%= guildMeta.id %>?refresh_members=1#access"><%= d('access.retryFetch') %></a>
                    </p>
                  <% } %>
                  <button class="btn" type="submit"><%= d('access.inviteSubmit') %></button>
                </form>
              <% } %>
            </section>
            <section class="panel">
              <h2><%= d('access.invitedTitle') %></h2>

              <p class="muted"><%= d('tickets.placePanelLead') %></p>
              <form method="post" action="/guild/<%= guildMeta.id %>/panel" class="form-grid">
                <label><%= d('common.channelLabel') %>
                  <select name="channel_id" required>
                    <option value=""><%= d('common.chooseChannel') %></option>
                    <% textChannels.forEach(function(c) { %>
                      <option value="<%= c.id %>">#<%= c.name %></option>

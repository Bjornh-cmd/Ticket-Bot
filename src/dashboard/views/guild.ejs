                                  </label>
                                  <label><%= d('tickets.questionFieldPlaceholder') %>
                                    <input data-q-field="placeholder" name="q<%= qi + 1 %>_placeholder" value="<%= q.placeholder || '' %>" maxlength="100" placeholder="<%= d('tickets.questionFieldPlaceholderExample') %>" />
                                  </label>
                                  <label><%= d('tickets.questionStyle') %>
                                    <select data-q-field="style" name="q<%= qi + 1 %>_style">
                                      <option value="paragraph" <%= q.style !== 'short' ? 'selected' : '' %>><%= d('tickets.styleParagraph') %></option>
                                      <option value="short" <%= q.style === 'short' ? 'selected' : '' %>><%= d('tickets.styleShort') %></option>
                                    </select>
                                  </label>
                                  <label class="check-inline">
                                    <input data-q-field="required" type="checkbox" name="q<%= qi + 1 %>_required" value="1" <%= q.required ? 'checked' : '' %> />
                                    <%= d('tickets.questionRequired') %>
                                  </label>
                                  <button type="button" class="ticket-q-remove" aria-label="<%= d('js.removeAria') %>">−</button>
                                </div>
                              <% }) %>
                            </div>
                            <button type="button" class="btn ghost small ticket-q-add" style="margin-top:0.55rem"><%= d('tickets.addQuestion') %></button>
                          </div>
                        <% } else { %>
                          <p class="err-banner" style="margin:0"><%- d('tickets.questionsLocked') %></p>
                        <% } %>
                      </div>
                      <div class="cta-row full">
                        <button class="btn" type="submit"><%= d('tickets.saveTypeButton') %></button>
                      </div>
                    </form>
                    <form method="post" action="/guild/<%= guildMeta.id %>/ticket-types/<%= t.id %>/delete" style="margin-top:0.65rem" onsubmit="return confirm('<%= d('tickets.confirmDeleteType') %>');">
                      <button class="btn ghost small" type="submit"><%= d('common.remove') %></button>
                    </form>
                  </details>
                <% }) %>

                    <input type="checkbox" name="only_bot" value="1" />
                    <%= d('messages.onlyBotLabel') %>
                  </span>
                </label>
                <button class="btn ghost" type="submit"><%= d('messages.deleteButton') %></button>
              </form>
            </section>
            <% } %>

            <section class="panel">
              <h2><%= d('messages.prefixTitle') %></h2>
              <p class="muted"><%- d('messages.prefixLead') %></p>
              <% if (!features.customPrefixCommands) { %>
                <p class="err-banner" style="margin-top:0.75rem"><%- d('messages.prefixLocked', { plan: plan.name }) %></p>
              <% } else { %>
                <% const prefixCount = customPrefixCommands.length; %>
                <% const prefixMax = maxPrefixCommands; %>
                <p class="muted" style="margin-top:0.35rem">
                  <% if (prefixMax === Infinity) { %>
                    <%= d('messages.prefixLimitUnlimited', { count: prefixCount }) %>
                  <% } else { %>
                    <%= d('messages.prefixLimitLabel', { count: prefixCount, max: prefixMax }) %>
                  <% } %>
                </p>
                <% if (prefixMax !== Infinity && prefixCount > prefixMax) { %>
                  <p class="err-banner" style="margin-top:0.65rem"><%= d('messages.prefixOverLimit', { max: prefixMax }) %></p>
                <% } %>

                <% if (customPrefixCommands.length) { %>
                  <% customPrefixCommands.forEach(function(cmd) { %>
                    <% const cmdChannel = cmd.channel_id ? textChannels.find(function(c) { return c.id === cmd.channel_id; }) : null; %>
                    <details class="ticket-type-card" style="margin-top:0.75rem">
                      <summary>
                        <span><code>!<%= cmd.trigger %></code></span>
                        <span class="muted"><%= cmdChannel ? '#' + cmdChannel.name : d('messages.prefixChannelAll') %></span>
                      </summary>
                      <form method="post" action="/guild/<%= guildMeta.id %>/prefix-commands/<%= cmd.id %>" class="form-grid" style="margin-top:0.85rem">
                        <label><%= d('messages.prefixTriggerLabel') %>
                          <input name="trigger" value="<%= cmd.trigger %>" placeholder="<%= d('messages.prefixTriggerPlaceholder') %>" required maxlength="32" />
                          <span class="muted" style="font-size:0.82rem"><%= d('messages.prefixTriggerHint') %></span>
                        </label>
                        <label><%= d('messages.prefixChannelLabel') %>
                          <select name="channel_id">
                            <option value=""><%= d('messages.prefixChannelAll') %></option>
                            <% textChannels.forEach(function(c) { %>
                              <option value="<%= c.id %>" <%= cmd.channel_id === c.id ? 'selected' : '' %>>#<%= c.name %></option>
                            <% }) %>
                          </select>
                        </label>
                        <label class="full"><%= d('messages.prefixResponseLabel') %>
                          <textarea name="response" rows="5" required maxlength="2000" placeholder="<%= d('messages.prefixResponsePlaceholder') %>"><%= cmd.response %></textarea>
                        </label>
                        <button class="btn" type="submit"><%= d('messages.prefixSaveButton') %></button>
                      </form>
                      <form method="post" action="/guild/<%= guildMeta.id %>/prefix-commands/<%= cmd.id %>/delete" style="margin-top:0.65rem" onsubmit="return confirm('<%= d('messages.prefixConfirmDelete') %>');">
                        <button class="btn ghost" type="submit"><%= d('common.remove') %></button>
                      </form>
                    </details>
                  <% }) %>
                <% } else { %>
                  <p class="muted" style="margin:0.75rem 0 0"><%= d('messages.prefixEmpty') %></p>
                <% } %>

                <% if (prefixMax === Infinity || prefixCount < prefixMax) { %>
                  <form method="post" action="/guild/<%= guildMeta.id %>/prefix-commands" class="form-grid" style="margin-top:1rem">
                    <label><%= d('messages.prefixTriggerLabel') %>
                      <input name="trigger" placeholder="<%= d('messages.prefixTriggerPlaceholder') %>" required maxlength="32" />
                      <span class="muted" style="font-size:0.82rem"><%= d('messages.prefixTriggerHint') %></span>
                    </label>
                    <label><%= d('messages.prefixChannelLabel') %>
                      <select name="channel_id">
                        <option value=""><%= d('messages.prefixChannelAll') %></option>
                        <% textChannels.forEach(function(c) { %>
                          <option value="<%= c.id %>">#<%= c.name %></option>
                        <% }) %>
                      </select>
                    </label>
                    <label class="full"><%= d('messages.prefixResponseLabel') %>
                      <textarea name="response" rows="5" required maxlength="2000" placeholder="<%= d('messages.prefixResponsePlaceholder') %>"></textarea>
                    </label>
                    <button class="btn" type="submit"><%= d('messages.prefixAddButton') %></button>
                  </form>
                <% } %>
              <% } %>
            </section>
          </div>

          <div data-panel="polls">
            <div class="page-head">
              <h1><%= d('nav.polls') %></h1>
              <p><%= d('polls.lead') %></p>
            </div>
            <% if (!features.polls) { %>
              <section class="panel">
                <p class="err-banner" style="margin:0"><%- d('polls.locked', { plan: plan.name }) %></p>
              </section>
            <% } else { %>
            <section class="panel">
              <form method="post" action="/guild/<%= guildMeta.id %>/polls" class="form-grid">
                <label class="full"><%= d('polls.questionLabel') %>
                  <input name="question" placeholder="<%= d('polls.questionPlaceholder') %>" required />
                </label>
                <label><%= d('common.channelLabel') %>
                  <select name="channel_id" required>
                    <option value=""><%= d('common.chooseChannel') %></option>
                    <% textChannels.forEach(function(c) { %>
                      <option value="<%= c.id %>">#<%= c.name %></option>
                    <% }) %>
                  </select>
                </label>
                <label><%= d('common.endsAtLabel') %>
                  <input type="datetime-local" name="ends_at" required />
                </label>
                <label class="full">
                  <span style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
                    <label style="display:flex;align-items:center;gap:0.4rem;margin:0">
                      <input type="checkbox" name="vote_once" value="1" checked />
                      <%= d('polls.voteOnceLabel') %>
                    </label>
                    <label style="display:flex;align-items:center;gap:0.4rem;margin:0">
                      <input type="checkbox" name="allow_multi" value="1" />
                      <%= d('polls.allowMultiLabel') %>
                    </label>
                  </span>
                </label>
                <div class="full poll-options-wrap">
                  <div class="poll-options-head">
                    <strong><%= d('polls.answersTitle') %></strong>
                    <span class="muted"><%= d('polls.answersHint') %></span>
                  </div>
                  <div id="poll-options" class="poll-options" data-max="10"></div>
                  <button type="button" class="btn ghost small" id="poll-add-option"><%= d('polls.addAnswerButton') %></button>
                </div>
                <button class="btn" type="submit"><%= d('polls.submitButton') %></button>
              </form>
            </section>

            <% if (typeof polls !== 'undefined' && polls.length) { %>
              <section class="panel">
                <h2><%= d('polls.recentTitle') %></h2>
                <table>
                  <thead><tr><th><%= d('common.id') %></th><th><%= d('polls.thQuestion') %></th><th><%= d('common.status') %></th><th><%= d('common.endsAt') %></th><th></th></tr></thead>
                  <tbody>
                    <% polls.forEach(function(p) { %>
                      <tr>
                        <td>#<%= p.id %></td>
                        <td><%= p.question %></td>
                        <td><span class="badge <%= p.status %>"><%= p.status %></span></td>
                        <td><%= new Date(p.ends_at).toLocaleString(guildLocale === 'nl' ? 'nl-NL' : 'en-GB') %></td>
                        <td>
                          <% if (p.status === 'active') { %>
                            <form method="post" action="/guild/<%= guildMeta.id %>/polls/<%= p.id %>/end">
                              <button class="btn ghost small" type="submit"><%= d('common.close') %></button>
                            </form>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </section>
            <% } %>
            <% } %>
          </div>

          <div data-panel="giveaways">
            <div class="page-head">
              <h1><%= d('nav.giveaways') %></h1>
              <p><%= d('giveaways.lead') %></p>
            </div>
            <% if (!features.giveaways) { %>
              <section class="panel">
                <p class="err-banner" style="margin:0"><%- d('giveaways.locked') %></p>
              </section>
            <% } else { %>
              <section class="panel">
                <form method="post" action="/guild/<%= guildMeta.id %>/giveaways" class="form-grid">
                  <label class="full"><%= d('giveaways.titleLabel') %>
                    <input name="title" placeholder="<%= d('giveaways.titlePlaceholder') %>" required maxlength="200" />
                  </label>
                  <label><%= d('giveaways.prizeLabel') %>
                    <input name="prize" placeholder="<%= d('giveaways.prizePlaceholder') %>" required maxlength="200" />
                  </label>
                  <label><%= d('giveaways.winnersCountLabel') %>
                    <input type="number" name="winners_count" min="1" max="20" value="1" />
                  </label>
                  <label><%= d('common.channelLabel') %>
                    <select name="channel_id" required>
                      <option value=""><%= d('common.chooseChannel') %></option>
                      <% textChannels.forEach(function(c) { %>
                        <option value="<%= c.id %>">#<%= c.name %></option>
                      <% }) %>
                    </select>
                  </label>
                  <label><%= d('common.endsAtLabel') %>
                    <input type="datetime-local" name="ends_at" required />
                  </label>
                  <label><%= d('giveaways.requiredRoleLabel') %>
                    <select name="required_role_id">
                      <option value=""><%= d('common.none') %></option>
                      <% (roles || []).forEach(function(r) { %>
                        <option value="<%= r.id %>">@<%= r.name %></option>
                      <% }) %>
                    </select>
                  </label>
                  <label class="full"><%= d('giveaways.descriptionLabel') %>
                    <textarea name="description" rows="2" placeholder="<%= d('giveaways.descriptionPlaceholder') %>"></textarea>
                  </label>
                  <label class="full"><%= d('giveaways.prizeDmLabel') %>
                    <textarea name="prize_dm" rows="3" placeholder="<%= d('giveaways.prizeDmPlaceholder') %>"></textarea>
                  </label>
                  <p class="muted full" style="margin:0"><%- d('giveaways.placeholdersHint') %></p>
                  <label class="full"><%= d('giveaways.imageUrlLabel') %>
                    <input name="image_url" type="url" placeholder="https://…/banner.png" />
                  </label>
                  <button class="btn" type="submit"><%= d('giveaways.submitButton') %></button>
                </form>
                <p class="muted" style="margin-top:0.75rem"><%- d('giveaways.commandHint') %></p>
              </section>
              <% if (typeof giveaways !== 'undefined' && giveaways.length) { %>
                <section class="panel">
                  <h2><%= d('giveaways.recentTitle') %></h2>
                  <table>
                    <thead><tr><th><%= d('common.id') %></th><th><%= d('giveaways.thTitle') %></th><th><%= d('common.status') %></th><th><%= d('common.endsAt') %></th><th></th></tr></thead>
                    <tbody>
                      <% giveaways.forEach(function(g) { %>
                        <tr>
                          <td>#<%= g.id %></td>
                          <td><%= g.title %></td>
                          <td><span class="badge <%= g.status %>"><%= g.status %></span></td>
                          <td><%= new Date(g.ends_at).toLocaleString(guildLocale === 'nl' ? 'nl-NL' : 'en-GB') %></td>
                          <td style="display:flex;gap:0.35rem;flex-wrap:wrap">
                            <% if (g.status === 'active') { %>
                              <form method="post" action="/guild/<%= guildMeta.id %>/giveaways/<%= g.id %>/end">
                                <button class="btn ghost small" type="submit"><%= d('giveaways.endButton') %></button>
                              </form>
                            <% } else { %>
                              <form method="post" action="/guild/<%= guildMeta.id %>/giveaways/<%= g.id %>/reroll">
                                <button class="btn ghost small" type="submit"><%= d('giveaways.rerollButton') %></button>
                              </form>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </section>
              <% } %>
            <% } %>
          </div>

          <% if (isGuildOwner && features.commandOverrides) { %>
          <div data-panel="commands">
            <div class="page-head">
              <h1><%= d('nav.commands') %></h1>
              <p><%= d('commands.lead') %></p>
            </div>
            <section class="panel">
              <h2><%= d('commands.serverWideTitle') %></h2>
              <p class="muted"><%= d('commands.serverWideLead') %></p>
              <div class="cmd-list">
                <% (commandList || []).forEach(function(cmd) {
                  var off = (disabledCommands || []).indexOf(cmd.name) !== -1;
                %>
                  <div class="cmd-row <%= off ? 'is-off' : 'is-on' %>">
                    <div class="cmd-meta">
                      <code>/<%= cmd.name %></code>
                      <span class="muted"><%= cmd.description || '—' %></span>
                    </div>
                    <form method="post" action="/guild/<%= guildMeta.id %>/commands/toggle" class="cmd-toggle">
                      <input type="hidden" name="scope" value="guild" />
                      <input type="hidden" name="command" value="<%= cmd.name %>" />
                      <input type="hidden" name="enabled" value="<%= off ? '1' : '0' %>" />
                      <button type="submit" class="btn small <%= off ? 'ghost' : '' %>" aria-pressed="<%= off ? 'false' : 'true' %>">
                        <%= off ? d('common.off') : d('common.on') %>
                      </button>
                    </form>
                  </div>
                <% }) %>
              </div>
            </section>

            <section class="panel">
              <h2><%= d('commands.perUserTitle') %></h2>
              <p class="muted"><%= d('commands.perUserLead') %></p>
              <form method="get" action="/guild/<%= guildMeta.id %>" class="form-grid cmd-user-form" style="margin-bottom:1rem">
                <label class="full"><%= d('commands.memberLabel') %>
                  <div class="inline-row">
                    <select name="cmd_user" required>
                      <option value=""><%= d('commands.chooseMember') %></option>
                      <% (members || []).forEach(function(m) { %>
                        <option value="<%= m.id %>" <%= overrideUserId === m.id ? 'selected' : '' %>><%= m.displayName %> (@<%= m.username %>)</option>
                      <% }) %>
                    </select>
                    <button class="btn" type="submit"><%= d('commands.loadButton') %></button>
                  </div>
                </label>
              </form>
              <% if (overrideUserId) { %>
                <p class="muted" style="margin-top:0"><%= d('commands.overridesFor') %> <code><%= overrideUserId %></code></p>
                <div class="cmd-list">
                  <% (commandList || []).forEach(function(cmd) {
                    var off = (userDisabledCommands || []).indexOf(cmd.name) !== -1;
                  %>
                    <div class="cmd-row <%= off ? 'is-off' : 'is-on' %>">
                      <div class="cmd-meta">
                        <code>/<%= cmd.name %></code>
                        <span class="muted"><%= cmd.description || '—' %></span>
                      </div>
                      <form method="post" action="/guild/<%= guildMeta.id %>/commands/toggle" class="cmd-toggle">
                        <input type="hidden" name="scope" value="user" />
                        <input type="hidden" name="user_id" value="<%= overrideUserId %>" />
                        <input type="hidden" name="command" value="<%= cmd.name %>" />
                        <input type="hidden" name="enabled" value="<%= off ? '1' : '0' %>" />
                        <button type="submit" class="btn small <%= off ? 'ghost' : '' %>">
                          <%= off ? d('common.off') : d('common.on') %>
                        </button>
                      </form>
                    </div>
                  <% }) %>
                </div>
              <% } %>
              <% if (overrideUsers && overrideUsers.length) { %>
                <h3 style="margin-top:1.25rem;font-size:0.95rem"><%= d('commands.usersWithOverrides') %></h3>
                <ul class="override-users">
                  <% overrideUsers.forEach(function(uid) { %>
                    <li>
                      <a href="/guild/<%= guildMeta.id %>?cmd_user=<%= uid %>#commands"><code><%= uid %></code></a>
                    </li>
                  <% }) %>
                </ul>
              <% } %>
            </section>
          </div>
          <% } %>

          <div data-panel="branding">
            <div class="page-head">
              <h1><%= d('branding.title') %></h1>
              <p><%= d('branding.lead') %></p>
              <p class="muted"><%- d('branding.deskPricing') %></p>
            </div>
            <% if (!features.branding) { %>
              <section class="panel">
                <p class="err-banner" style="margin:0"><%- d('branding.locked') %></p>
              </section>
            <% } else { %>
              <section class="panel">
                <div class="branding-preview">
                  <% if (overview.botAvatar) { %>
                    <img src="<%= overview.botAvatar %>" alt="" width="72" height="72" />
                  <% } %>
                  <div>
                    <strong><%= overview.botNick %></strong>
                    <p class="muted" style="margin:0.25rem 0 0"><%= d('branding.currentDisplay', { server: guildMeta.name }) %></p>
                  </div>
                </div>
                <form method="post" action="/guild/<%= guildMeta.id %>/branding" class="form-grid" style="margin-top:1rem" enctype="multipart/form-data">
                  <label><%= d('branding.nickLabel') %>
                    <input name="bot_nick" maxlength="32" value="<%= settings.bot_nick || overview.botNick || '' %>" placeholder="Reedhall" />
                  </label>
                  <label class="full"><%= d('branding.avatarLabel') %>
                    <input name="avatar_file" type="file" accept="image/png,image/jpeg,image/webp,image/gif,.png,.jpg,.jpeg,.webp,.gif,.ico" />
                  </label>
                  <label>
                    <span style="display:flex;align-items:center;gap:0.5rem;margin-top:1.6rem">
                      <input type="checkbox" name="reset_avatar" value="1" />
                      <%= d('branding.resetLabel') %>
                    </span>
                  </label>
                  <button class="btn" type="submit"><%= d('branding.saveButton') %></button>
                </form>
                <p class="muted" style="margin-top:0.75rem"><%= d('branding.footnote') %></p>
              </section>
            <% } %>
          </div>

          <div data-panel="logs">
            <div class="page-head">
              <h1><%= d('nav.logs') %></h1>
              <p><%= d('logs.lead') %></p>
            </div>
            <section class="panel">
              <h2><%= d('logs.modLogTitle') %></h2>
              <% if (!actions.length) { %>
                <p class="muted"><%= d('logs.noActions') %></p>
              <% } else { %>
                <table>
                  <thead><tr><th><%= d('logs.thAction') %></th><th><%= d('logs.thTarget') %></th><th><%= d('logs.thModerator') %></th><th><%= d('logs.thReason') %></th><th><%= d('logs.thWhen') %></th></tr></thead>
                  <tbody>
                    <% actions.forEach(function(a) { %>
                      <tr>
                        <td><%= a.action %></td>
                        <td><code><%= a.target_id %></code></td>
                        <td><code><%= a.moderator_id %></code></td>
                        <td><%= a.reason || '—' %></td>
                        <td><%= a.created_at %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              <% } %>
            </section>
            <section class="panel">
              <h2><%= d('logs.activeWarningsTitle') %></h2>
              <% if (!warnings.length) { %>
                <p class="muted"><%= d('logs.noWarnings') %></p>
              <% } else { %>
                <table>
                  <thead><tr><th><%= d('common.id') %></th><th><%= d('logs.thUser') %></th><th><%= d('logs.thModerator') %></th><th><%= d('logs.thReason') %></th><th><%= d('logs.thDate') %></th><th></th></tr></thead>
                  <tbody>
                    <% warnings.forEach(function(w) { %>
                      <tr>
                        <td>#<%= w.id %></td>
                        <td><code><%= w.user_id %></code></td>
                        <td><code><%= w.moderator_id %></code></td>
                        <td><%= w.reason %></td>
                        <td><%= w.created_at %></td>
                        <td>
                          <form method="post" action="/guild/<%= guildMeta.id %>/warnings/<%= w.id %>/delete">
                            <button class="btn ghost small" type="submit"><%= d('common.remove') %></button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              <% } %>
            </section>
          </div>
        </div>
      </main>
    </div>
  </div>
  <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">window.REEDHALL_I18N = <%- dashJsJson || '{}' %>;</script>
  <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>" src="/app.js"></script>
</body>
</html>

# Discord Application
DISCORD_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
PUBLIC_KEY=

# Dashboard (use https:// in production)
# Coolify sets PORT. Locally DASHBOARD_PORT is enough.
DASHBOARD_PORT=3000
PORT=3000
DASHBOARD_URL=http://localhost:3000
# Persistent SQLite + uploads. In Docker/Coolify this is /app/data (volume).
# DATA_DIR=./data

# REQUIRED: random string, min 32 characters (e.g. openssl rand -hex 32)
SESSION_SECRET=

# Local-only escape hatch if SESSION_SECRET is missing — NEVER on a public host
# ALLOW_INSECURE_DEV=1

# Force production cookie/security mode even on http (usually set NODE_ENV=production)
# PUBLIC_RELEASE=1
# NODE_ENV=production

# Platform super-admins for /admin only (optional). Normal users do NOT need this —
# Discord Owner / Administrator / Manage Server = automatic Reedhall guild owner.
BOT_OWNER_IDS=
PLATFORM_ADMIN_IDS=
PLATFORM_ADMIN_USERNAMES=

# Link-login is disabled by default. Prefer Discord OAuth.
# If you enable it in /admin, passwords are stored hashed (scrypt).
# LINK_LOGIN_ENABLED=false

# Optional legacy allowlist (prefer dashboard linking)
# ALLOWED_GUILDS=

# Discord webhook for dashboard error reports (admin server)
ERROR_REPORT_WEBHOOK=

# --- Captcha is (stoplichten) — self-hosted on this Node process ---
# Generate signing secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTCHA_IS_SIGNING_SECRET=change-me-to-a-long-random-secret
CAPTCHA_IS_SITEKEY=pk_image
CAPTCHA_IS_SECRET=sk_image_change_me
# Comma-separated hosts allowed to request challenges (dashboard host is auto-added)
CAPTCHA_IS_DOMAINS=localhost,127.0.0.1
